{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuntimeSpec Probe Report",
  "description": "Schema for verification reports generated by probe execution",
  "type": "object",
  "required": [
    "id",
    "name",
    "runtime",
    "version",
    "timestamp",
    "hermetic_ok",
    "exit_code"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Probe identifier (e.g., p0, p1, p2)"
    },
    "name": {
      "type": "string",
      "description": "Human-readable probe name"
    },
    "runtime": {
      "type": "string",
      "description": "Runtime being verified (e.g., mise)"
    },
    "version": {
      "type": "string",
      "description": "RuntimeSpec version (e.g., 1.0.1)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp of probe execution"
    },
    "hermetic_ok": {
      "type": "boolean",
      "description": "Whether hermetic seal validation passed"
    },
    "exit_code": {
      "type": "integer",
      "description": "Probe exit code (0 = success, non-zero = failure)"
    },
    "probe": {
      "type": "object",
      "description": "Probe-specific results",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Summary of probe execution"
        },
        "checks": {
          "type": "object",
          "description": "Individual check results",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "output": {
          "type": "string",
          "description": "Probe stdout/stderr preview (first 500 chars)"
        },
        "output_hash": {
          "type": "string",
          "description": "SHA256 hash of full probe output"
        }
      }
    },
    "fingerprint": {
      "type": "string",
      "description": "SHA256 hash of spec file (for reproducibility)"
    },
    "duration_ms": {
      "type": "integer",
      "description": "Probe execution time in milliseconds"
    },
    "environment": {
      "type": "object",
      "description": "Environment info at probe time",
      "properties": {
        "runtime_version": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
